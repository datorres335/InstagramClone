# Expo only loads .env files from its own project root (apps/mobile), not the
# monorepo root. See docs/PROGRESS.md Known Issues.
#
# `localhost` inside a device/emulator is the device itself, not your PC:
#   Android emulator: http://10.0.2.2:3000/api/v1 (emulator alias for the host's localhost)
#   iOS simulator:    http://localhost:3000/api/v1 (shares the Mac's network)
#   Physical phone:   http://<your PC's LAN IP>:3000/api/v1, with the API started on
#                     HOST=0.0.0.0 and port 3000 allowed through the firewall
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
