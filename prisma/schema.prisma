datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// ---------------------------------------------------------------------------
// Conventions (see docs/DATABASE.md §1):
//   - Primary keys: Prisma-generated UUIDv7 (`uuid(7)`), stored as native `uuid`.
//   - Tables/columns are snake_case in Postgres (`@@map`/`@map`), camelCase in
//     the Prisma Client.
//   - `createdAt`/`updatedAt` on every table; `deletedAt` only on tables that
//     support soft delete.
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid(7)) @db.Uuid

  // citext (case-insensitive text) — extension enabled in this migration.
  username String @unique @db.Citext
  email    String @unique @db.Citext

  passwordHash String @map("password_hash")

  fullName   String? @map("full_name")
  bio        String?
  websiteUrl String? @map("website_url")

  // Reserved for a future follow-request workflow — MVP follow is always
  // immediate regardless of this flag (see docs/FEATURES.md #5).
  isPrivate Boolean @default(false) @map("is_private")

  // Bumped to invalidate all outstanding access tokens (e.g. on password
  // change) without needing an access-token allowlist.
  tokenVersion Int @default(0) @map("token_version")

  // Reserved — MVP does not require verification before login.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz

  // Deferred out of the Milestone 2 migration (docs/DATABASE.md §3.1's
  // deviation note): `Media` didn't exist yet. Lands here, in the same
  // migration that creates `Media` (Milestone 9). Nullable FK, not required
  // — most users never set an avatar. `@unique` makes this a true one-to-one
  // (a given media row can be at most one user's avatar — a real invariant,
  // not incidental). `onDelete: SetNull` rather than `Cascade`: deleting the
  // underlying `Media` row (not a flow this MVP implements, but defensively
  // correct regardless) should clear the avatar, not the user.
  avatarMediaId String? @unique @map("avatar_media_id") @db.Uuid
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  mediaOwned    Media[]        @relation("MediaOwner")

  // `following`: rows where this user is the follower (who I follow).
  // `followers`: rows where this user is being followed (who follows me).
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  posts      Post[]      @relation("AuthoredPosts")
  likes      Like[]
  comments   Comment[]
  savedPosts SavedPost[]

  // `notificationsReceived`: rows where this user is notified (e.g. "bob
  // liked your post"). `notificationsSent`: rows where this user is the
  // actor who triggered someone else's notification — not surfaced by any
  // endpoint today, but the reverse side of `Notification.actorId` still
  // needs a named relation on both ends.
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  conversationParticipations ConversationParticipant[]
  messagesSent               Message[]

  @@index([deletedAt])
  // GIN trigram indexes powering User Search's similarity() ranking
  // (docs/DATABASE.md §5/§6, Milestone 17) — `pg_trgm`'s `gin_trgm_ops`
  // operator class, not a plain btree.
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

/// Backs the rotating-refresh-token auth design (docs/ARCHITECTURE.md §7).
model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Shared by every token descended from one login; a replayed, already-
  // rotated-away token revokes the whole family (reuse detection).
  familyId String @map("family_id") @db.Uuid

  // SHA-256 of the opaque token handed to the client — never the raw token.
  tokenHash String @unique @map("token_hash")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address") @db.Inet

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Set on rotation; supports a reuse-detection audit trail.
  replacedByTokenHash String? @map("replaced_by_token_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum MediaPurpose {
  AVATAR
  POST_IMAGE
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}

/// A single generic asset table for both avatars and post images
/// (docs/DATABASE.md §3.3) — both go through the identical
/// presign → upload → process pipeline (docs/ARCHITECTURE.md §8).
model Media {
  id String @id @default(uuid(7)) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  purpose MediaPurpose
  status  MediaStatus  @default(PENDING)

  // Original upload's object key. Never a full URL — resolved to one at
  // response time (docs/ARCHITECTURE.md §8), so storage configuration can
  // change without a data migration.
  storageKey String @map("storage_key")

  // e.g. `{ "thumbnail": "key...", "feed": "key..." }` — populated once
  // `status` becomes `READY`. A fixed, code-defined key set, not
  // independently queryable data, so a jsonb column (not a child table) is
  // the right trade-off here.
  variants Json?

  width  Int?
  height Int?

  // Low-cost placeholder for progressive image loading.
  blurhash String?

  byteSize    Int    @map("byte_size")
  contentType String @map("content_type")

  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  avatarOfUser User?      @relation("UserAvatar")
  postMedia    PostMedia?

  @@index([ownerId, status])
  @@map("media")
}

/// Immediate, no-approval follow edge (docs/DATABASE.md §3.6, docs/FEATURES.md #5 —
/// `User.isPrivate` exists but the MVP does not gate this behind a request/approval
/// workflow). A composite PK naturally prevents duplicate follows; self-follows are
/// rejected in `FollowsService`, not the schema — Prisma has no portable `@@check`
/// constraint, so the equivalent `CHECK (follower_id <> following_id)` is added by
/// hand to this model's migration SQL instead (see the migration file).
model Follow {
  followerId  String @map("follower_id") @db.Uuid
  followingId String @map("following_id") @db.Uuid

  // "Follower": the edge where this user is the one doing the following.
  // "Following": the edge where this user is the one being followed.
  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The composite PK efficiently serves "who does X follow" (starts with
  // followerId); the secondary index below serves "who follows X" (followers
  // list) and follower-count aggregates — docs/DATABASE.md §3.6.
  @@id([followerId, followingId])
  @@index([followingId, followerId])
  @@map("follows")
}

/// One or more images with an optional caption/location (docs/DATABASE.md §3.4,
/// docs/FEATURES.md #7/#8). The 1–10 image bound is enforced in `PostsService`,
/// not the schema — Prisma has no row-count-per-parent constraint.
model Post {
  id String @id @default(uuid(7)) @db.Uuid

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)

  caption  String?
  location String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  media         PostMedia[]
  likes         Like[]
  comments      Comment[]
  savedBy       SavedPost[]
  notifications Notification[]

  // Serves "posts by this user, newest first" (profile grid, docs/DATABASE.md
  // §3.4) — a plain B-tree, not the partial `WHERE deletedAt IS NULL` index
  // originally specified there; same Prisma-has-no-partial-index deviation
  // already recorded for `User.deletedAt` (Milestone 2).
  @@index([authorId, createdAt(sort: Desc)])
  @@map("posts")
}

/// Ordered join between a `Post` and its `Media` (docs/DATABASE.md §3.5).
/// `mediaId` is `@unique` — beyond the documented `unique(postId, mediaId)`,
/// a media row can be attached to at most one post, ever ("not already
/// attached elsewhere", docs/API.md §7) — enforced here, not only checked in
/// `PostsService`, the same "`@unique` is the real invariant" reasoning
/// Milestone 9 applied to `User.avatarMediaId`. That also makes the
/// documented `unique(postId, mediaId)` redundant (a unique `mediaId` alone
/// already implies it), so only `unique(postId, position)` is a second index.
model PostMedia {
  id String @id @default(uuid(7)) @db.Uuid

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String @unique @map("media_id") @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id])

  // 0-based order within the post's carousel (docs/FEATURES.md #8).
  position Int     @db.SmallInt
  altText  String? @map("alt_text")

  @@unique([postId, position])
  @@map("post_media")
}

/// A user's like on a post (docs/DATABASE.md §3.7, docs/FEATURES.md #11).
/// Composite PK doubles as the uniqueness constraint (a user can only like a
/// post once) and the primary access path ("has this user liked this
/// post?") — the same self-referential-uniqueness role `Follow`'s composite
/// PK plays (Milestone 10). Hard-deleted on unlike (docs/DATABASE.md §7):
/// the row existing is the entire meaning of this table, same as `Follow`.
model Like {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Composite PK serves "has :userId liked :postId" directly. Secondary
  // index on postId alone serves "count/list likers of a post" (a like
  // count and the likers list both filter on postId only, not the PK
  // prefix) — docs/DATABASE.md §3.7.
  @@id([userId, postId])
  @@index([postId])
  @@map("likes")
}

/// A flat comment on a post (docs/DATABASE.md §3.8, docs/FEATURES.md #12).
/// `parentCommentId` is reserved for future threaded replies — the API
/// never sets it in the MVP, so every comment is effectively top-level; the
/// self-relation exists so the column/index are in place without an
/// awkward later migration, not because threading is implemented now.
/// The third and last soft-deletable model (docs/DATABASE.md §7), alongside
/// `User` and `Post`.
model Comment {
  id String @id @default(uuid(7)) @db.Uuid

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  notifications Notification[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Serves "comments on this post, oldest first" (docs/DATABASE.md §3.8) —
  // a plain B-tree, not a partial `WHERE deletedAt IS NULL` index, the same
  // Prisma-has-no-partial-index deviation already recorded for
  // `User.deletedAt` (Milestone 2) and `Post`'s own index (Milestone 11).
  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@map("comments")
}

/// A user's private bookmark on a post (docs/DATABASE.md §3.9,
/// docs/FEATURES.md #13) — never visible to anyone but the saver, unlike
/// `Like` (which has a public likers list). Composite PK doubles as the
/// uniqueness constraint and the primary "has :userId saved :postId" access
/// path, the same role `Like`'s composite PK plays — but unlike `Like`, the
/// *other* real query here is "this user's saved posts, newest first," which
/// the PK's own implicit index (ordered by `userId, postId`) can't serve, so
/// an explicit secondary index on `(userId, createdAt desc)` is needed too.
/// Hard-deleted on unsave (docs/DATABASE.md §7): the row existing is the
/// entire meaning of this table, same as `Follow`/`Like`.
model SavedPost {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_posts")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
}

/// A single in-app notification (docs/DATABASE.md §3.10, docs/FEATURES.md
/// #16) — generated asynchronously via a BullMQ job enqueued by the
/// triggering action (follow/like/comment), never written synchronously in
/// the request path (docs/ARCHITECTURE.md risk #10). Nullable `postId`/
/// `commentId` FKs rather than a polymorphic (entityType, entityId) pair:
/// with only three notification types in the MVP, explicit nullable FKs
/// keep referential integrity enforced by Postgres itself — a dangling
/// notification is structurally impossible. `recipientId`/`actorId` both FK
/// `User`, requiring named relations on both ends since a notification
/// references `User` twice. `actorId` is nullable (reserved for a future
/// system notification with no actor — every type implemented in the MVP
/// always has one) with `onDelete: SetNull`, the same "optional FK, keep
/// the row if the referenced optional side disappears" reasoning
/// `User.avatarMediaId` already established — unlike `recipientId`, which
/// `onDelete: Cascade`s since a notification with no recipient is
/// meaningless.
model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  recipientId String @map("recipient_id") @db.Uuid
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type NotificationType

  postId String? @map("post_id") @db.Uuid
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?  @map("comment_id") @db.Uuid
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Serves the list/badge query: "this recipient's unread (or all)
  // notifications, newest first" (docs/DATABASE.md §3.10).
  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// A messaging thread (docs/DATABASE.md §3.11, docs/FEATURES.md DMs,
/// Milestone 21). A join-table shape (`ConversationParticipant`) rather than
/// a bare `Message(senderId, recipientId)` pair — supports group chat later
/// without a breaking schema change (docs/IMPLEMENTATION_PLAN.md M21). The
/// MVP only ever creates 1:1 conversations, enforced in
/// `ConversationsService`, not the schema.
model Conversation {
  id String @id @default(uuid(7)) @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Denormalized from the latest Message, bumped on every send — lets the
  // inbox list order "newest activity first" with a plain index instead of
  // a correlated subquery per conversation.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Join row between a `Conversation` and a `User` (docs/DATABASE.md §3.11).
/// Composite PK doubles as the uniqueness constraint (a user can only be in
/// a given conversation once) and the primary "is this user a participant"
/// access path — the first "membership," not "ownership"/"following,"
/// authorization shape in this codebase.
model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The composite PK serves "is :userId a participant in :conversationId"
  // directly. The secondary index on userId alone serves "this user's
  // conversations" (the inbox list's join side).
  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// A single message within a `Conversation` (docs/DATABASE.md §3.11). No
/// soft delete, no edit — the MVP never needs either
/// (docs/IMPLEMENTATION_PLAN.md M21 scope).
model Message {
  id String @id @default(uuid(7)) @db.Uuid

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body String

  // Set when the *other* participant has viewed this message — read receipts
  // beyond a boolean matter once group chat exists (M21 recommends keeping
  // that door open), but a single nullable timestamp is enough for 1:1.
  readAt DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Serves "messages in this conversation, oldest first" (keyset pagination,
  // the established convention).
  @@index([conversationId, createdAt])
  @@map("messages")
}
