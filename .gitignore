# Build outputs
dist/
out/
build/
.next/
# Auto-generated by `next dev`/`next build` on every run (its own header says
# "This file should not be edited") — was committed by mistake since
# Milestone 6, the generator's default `.gitignore` for a Next.js app
# includes this. Untracked now: its two import paths flip between
# `.next/types/...` (after `build`) and `.next/dev/types/...` (after `dev`),
# which meant it showed as "modified" in `git status` after nearly every
# local dev session for no real reason — it's not a code change, Next
# regenerates it identically on a fresh clone's first `dev`/`build` run.
apps/web/next-env.d.ts
.expo/
.expo-shared/
web-build/

