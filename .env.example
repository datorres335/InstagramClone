# Copy this file to .env and adjust values for your machine.
# Every variable here is read and validated by packages/config — see that
# package for the exact per-app Zod schemas. Nothing here is a real secret.

# ---- Postgres (docker-compose + Prisma) ----------------------------------
POSTGRES_USER=instagram_clone
POSTGRES_PASSWORD=instagram_clone
POSTGRES_DB=instagram_clone
# 5433, not 5432 — avoids colliding with a native/other Postgres that may
# already be running on this machine (see docker-compose.yml).
POSTGRES_PORT=5433
DATABASE_URL=postgresql://instagram_clone:instagram_clone@localhost:5433/instagram_clone?schema=public

# ---- Redis (BullMQ jobs, throttler storage) -------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage) ---------------------------------
MINIO_ROOT_USER=instagram_clone
MINIO_ROOT_PASSWORD=instagram_clone_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=instagram-clone-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=instagram_clone
S3_SECRET_ACCESS_KEY=instagram_clone_secret
S3_BUCKET=instagram-clone-media
S3_FORCE_PATH_STYLE=true

# ---- Maildev (local outbound email capture) --------------------------------
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- apps/api ---------------------------------------------------------------
# NODE_ENV is deliberately NOT set here: Nx loads this file into every task's
# environment (build/serve/test alike), and each tool (Next, Jest, ts-node...)
# needs to control its own NODE_ENV per command — pre-setting it broke `next
# build`, which forces NODE_ENV=production internally and misbehaves if it's
# already set to something else. apps/api defaults to "development" in
# packages/config's apiEnvSchema when this var is absent.
PORT=3000
HOST=localhost
JWT_ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:4200

# ---- apps/web -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ---- apps/mobile (must be EXPO_PUBLIC_ prefixed to reach the client bundle) --
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
